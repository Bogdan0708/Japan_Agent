# The application defaults to paper trading and refuses live orders unless all
# independent live gates are present. Never commit real values.
T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=
T212_ACCOUNT_CURRENCY=GBP

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_USER_ID=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

JQUANTS_API_KEY=
EDINET_API_KEY=

# Live-only gates. See docs/COMPLIANCE.md. Do not set for paper trading.
ALLOW_LIVE_TRADING=
T212_WRITTEN_CONSENT_REF=
LIVE_GATE_FILE=
